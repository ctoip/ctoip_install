FROM eclipse-temurin:8-jdk-jammy AS builder

WORKDIR /workspace
COPY ctoip/ ./ctoip/
WORKDIR /workspace/ctoip
RUN chmod +x mvnw && ./mvnw clean package -DskipTests

FROM eclipse-temurin:8-jre-jammy

WORKDIR /usr/local
RUN apt-get update \
    && apt-get install --no-install-recommends -y nmap \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/ctoip/target/*.jar /usr/local/ctoip.jar
COPY ctoip/release/application.yml /usr/local/application.yml

EXPOSE 8081
CMD ["java", "-jar", "ctoip.jar", "--spring.config.location=/usr/local/application.yml"]
